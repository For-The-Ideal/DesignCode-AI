{
  "name": "frontend",
  "type": "module",
  "private": true,
 "scripts": {
  "dev": "set NODE_OPTIONS=--max-old-space-size=8192 && nuxt dev --dotenv .env.dev --open",
  "build": "set NODE_OPTIONS=--max-old-space-size=8192 && nuxt build --dotenv .env.prod",
  "start": "set NODE_ENV=prod && node .output/server/index.mjs",
  "preview": "nuxt preview",
  "postinstall": "nuxt prepare"
},
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "bcrypt": "^6.0.0",
    "crypto-js": "^4.2.0",
    "element-plus": "^2.14.1",
    "monaco-editor": "^0.55.1",
    "nuxt": "^4.4.2",
    "vue": "^3.5.30",
    "oxc-parser": "^0.133.0"
  },
  "devDependencies": {
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@types/node": "^25.5.0",
    "sass-embedded": "^1.98.0",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}


