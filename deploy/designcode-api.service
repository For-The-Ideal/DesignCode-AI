[Unit]
Description=DesignCode-AI API (Go/Gin)
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/DesignCode-AI/frontend_api
Environment=APP_ENV=prod
Environment=GIN_MODE=release
ExecStart=/root/DesignCode-AI/frontend_api/server
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
