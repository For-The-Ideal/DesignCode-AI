        ),
      ],
    );
  }

  void _showCategoryMultiSelectDialog() {
    // 临时保存本次选择
    List<String> tempSelected = List.from(_selectedCategories);
    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text('选择面料品类'),
              content: SizedBox(
                width: double.maxFinite,
