// 主流程页面
class FabricRequirementFlowPage extends StatefulWidget {
  const FabricRequirementFlowPage({super.key});

  @override
  State<FabricRequirementFlowPage> createState() =>
      _FabricRequirementFlowPageState();
}

class _FabricRequirementFlowPageState
    extends State<FabricRequirementFlowPage> {
  int _currentStep = 0;

  // 步骤1 数据
  List<Widget> _imagePreviews = []; // 图片预览组件
  String _regionInfo = '未选择';

  // 步骤2 数据
  String _similarity = '100%一致';
  List<String> _selectedCategories = [];
  String _delivery = '现货';

  // 步骤3 数据
  final TextEditingController _remarkController =
      TextEditingController();

  @override
  void initState() {
    super.initState();
    // 初始一张占位上传卡片
    _imagePreviews.add(_buildUploadPlaceholder());
  }

  @override
  void dispose() {
    _remarkController.dispose();
    super.dispose();
  }

  // ---------- 通用上传占位组件 ----------
  Widget _buildUploadPlaceholder({VoidCallback? onTap}) {
    return GestureDetector(
      onTap: onTap ?? _simulateAddImage,
      child: AspectRatio(
        aspectRatio: 1,
        child: Card(
          elevation: 2,
          child: Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(Icons.add_photo_alternate_outlined,
                    size: 48, color: Colors.grey.shade600),
                const SizedBox(height: 8),
                Text('+ 上传面料',
                    style: TextStyle(
                        fontSize: 14, color: Colors.grey.shade600)),
              ],
            ),
          ),
        ),
      ),
    );
  }

  // 模拟添加一张图片（实际应用中使用 image_picker）
  void _simulateAddImage() {
    if (_imagePreviews.length >= 4) return; // 最多3张 + 1个占位
    // 在占位前插入一张模拟图片
    final index = _imagePreviews.length - 1;
    setState(() {
      _imagePreviews.insert(
        index,
        _buildSimulatedImage(index.toString()),
      );
    });
  }

  Widget _buildSimulatedImage(String label) {
    return AspectRatio(
      aspectRatio: 1,
      child: Stack(
        children: [
          Container(
            decoration: BoxDecoration(
              color: Colors.primaries[
                  int.parse(label) % Colors.primaries.length],
              borderRadius: BorderRadius.circular(12),
            ),
            child: Center(
              child: Text(label,
                  style: const TextStyle(
                      color: Colors.white, fontSize: 24)),
            ),
          ),
          // 删除按钮
          Positioned(
            top: 4,
            right: 4,
            child: CircleAvatar(
              radius: 14,
              backgroundColor: Colors.black54,
              child: IconButton(
                iconSize: 18,
                icon: const Icon(Icons.close, color: Colors.white),
                onPressed: () {
                  setState(() {
                    _imagePreviews.removeAt(
                        _imagePreviews.indexOf(this));
                    // 确保最后一个是占位
                    if (_imagePreviews.isEmpty ||
                        _imagePreviews.last is! _UploadPlaceholder) {
                      _imagePreviews.add(_buildUploadPlaceholder());
                    }
                  });
                },
              ),
            ),
          ),
        ],
      ),
    );
  }

  // 识别占位组件的类型标记
  bool _isUploadPlaceholder(Widget w) {
    // 简单判断：如果是Card且内容包含'上传面料'文本
    return w.toString().contains('_buildUploadPlaceholder') ||
        (w is Card &&
            ((w.child as Center?)?.child as Column?)?.children
                    .any((c) =>
                        c is Text &&
