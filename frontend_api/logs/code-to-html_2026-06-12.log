              setState(() {
                _images.remove(path);
              });
            },
          ),
        ),
      ],
    );
  }

  Widget _buildAddImageButton() {
    return GestureDetector(
      onTap: () {
        // 模拟添加图片（实际使用image_picker）
        setState(() {
          _images.add('https://via.placeholder.com/150?text=Fabric+${_images.length + 1}');
        });
      },
      child: Container(
        width: 100,
        height: 100,
        decoration: BoxDecoration(
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: Theme.of(context).colorScheme.outline, style: BorderStyle.solid),
        ),
        child: const Icon(Icons.add_photo_alternate_outlined, size: 40),
      ),
    );
  }

  // 步骤1: 区域选择和相似度
  Widget _buildRegionAndSimilarityStep() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
