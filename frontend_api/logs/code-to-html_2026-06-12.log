import { ref, computed } from 'vue'

// ----- 类型定义 -----
interface PointSummary {
  points: number
  unit: string
  expiry: string
}

interface Transaction {
  id: number
  description: string
  status: string
  timestamp: string
  amount: number // 正数为获取，负数为消耗
  unit: string
  expiry: string
}

type TabType = '全部' | '获取' | '消耗'

