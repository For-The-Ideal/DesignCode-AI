    ),
    _CategoryGroup(
      name: '化纤类',
      items: ['涤纶', '锦纶', '氨纶', '腈纶'],
    ),
    _CategoryGroup(
      name: '混纺类',
      items: ['涤棉', '锦棉', '毛涤', '丝棉'],
    ),
  ];

  // 货期
  String _delivery = '现货'; // 或 '期货'

  // 补充说明
  final TextEditingController _noteController = TextEditingController();

  // 弹窗控制
  bool _showCategoryDialog = false;
  bool _showSuccessDialog = false;

  @override
  void dispose() {
    _noteController.dispose();
    super.dispose();
  }

  // 步骤说明列表
  List<String> get _stepDescriptions => [
    '上传面料图片（最多3张）',
    '选择找料区域和相似度',
    '选择面料品类',
    '选择货期与补充说明',
    '确认发布需求',
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('我要找料'),
        leading: IconButton(
          icon: const Icon(Icons.close),
          onPressed: () => Navigator.of(context).pop(),
        ),
      ),
      body: LayoutBuilder(
        builder: (context, constraints) {
          return Column(
            children: [
              // 步骤指示器
              _buildStepIndicator(),
              // 当前步骤说明
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                child: Text(
                  _stepDescriptions[_currentStep],
                  style: Theme.of(context).textTheme.titleMedium,
                ),
              ),
              // 步骤内容
              Expanded(
                child: Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16),
                  child: _buildStepContent(),
                ),
              ),
              // 底部操作（上一步/下一步）仅在非最后一步显示，最后一步显示提交/取消
              _buildBottomNavigation(),
            ],
          );
        },
      ),
    );
  }

  // 步骤指示器
  Widget _buildStepIndicator() {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 16, horizontal: 16),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.center,
        children: List.generate(_totalSteps, (index) {
          final isActive = index <= _currentStep;
          final isCurrent = index == _currentStep;
          return Expanded(
            child: Row(
              children: [
                // 圆点
                Container(
                  width: 32,
                  height: 32,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    color: isActive
                        ? Theme.of(context).colorScheme.primary
                        : Theme.of(context).colorScheme.surfaceVariant,
                  ),
                  alignment: Alignment.center,
                  child: Text(
                    '${index + 1}'.padLeft(2, '0'),
                    style: TextStyle(
                      color: isActive ? Colors.white : Theme.of(context).colorScheme.onSurfaceVariant,
                      fontWeight: FontWeight.bold,
                      fontSize: 13,
                    ),
                  ),
                ),
                // 连接线
                if (index < _totalSteps - 1)
                  Expanded(
                    child: Container(
                      height: 2,
                      color: index < _currentStep
                          ? Theme.of(context).colorScheme.primary
                          : Theme.of(context).colorScheme.outlineVariant,
                    ),
                  ),
              ],
            ),
          );
        }),
      ),
    );
  }

  // 根据当前步骤返回对应内容
  Widget _buildStepContent() {
    switch (_currentStep) {
      case 0:
        return _buildImageUploadStep();
      case 1:
        return _buildRegionAndSimilarityStep();
      case 2:
        return _buildCategorySelectionStep();
      case 3:
        return _buildDeliveryAndNoteStep();
      case 4:
        return _buildConfirmStep();
      default:
        return const SizedBox();
    }
  }

  // 步骤0: 图片上传
  Widget _buildImageUploadStep() {
    return Column(
      children: [
        const SizedBox(height: 16),
        // 已选图片展示（最多3张）
        Wrap(
          spacing: 12,
          runSpacing: 12,
          children: [
            ..._images.map((imgPath) => _buildImageThumbnail(imgPath)),
            if (_images.length < _maxImages)
              _buildAddImageButton(),
          ],
        ),
      ],
    );
  }

  Widget _buildImageThumbnail(String path) {
    return Stack(
      children: [
        Container(
          width: 100,
          height: 100,
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(8),
            border: Border.all(color: Theme.of(context).colorScheme.outline),
          ),
          child: ClipRRect(
            borderRadius: BorderRadius.circular(8),
            child: Image.network(
              path,
              fit: BoxFit.cover,
              errorBuilder: (context, error, stackTrace) => const Icon(Icons.image),
