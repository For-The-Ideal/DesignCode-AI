                _isCategoryExpanded ? '收起品类列表' : '${_selectedCategories.length > 0 ? "已选${_selectedCategories.length}项 " : ""}+点击选择',
                style: Theme.of(context).textTheme.bodySmall?.copyWith(color: Theme.of(context).colorScheme.primary),
              ),
              Icon(
                _isCategoryExpanded ? Icons.expand_less : Icons.expand_more,
                size: 18,
                color: Theme.of(context).colorScheme.primary,
              ),
            ],
          ),
        ),
        // 展开的下拉列表
        if (_isCategoryExpanded)
          Container(
            margin: const EdgeInsets.only(top: 8),
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              border: Border.all(color: Theme.of(context).colorScheme.outline),
              borderRadius: BorderRadius.circular(8),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: _categoryGroups.entries.map((group) {
                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(group.key, style: Theme.of(context).textTheme.labelMedium),
                    const SizedBox(height: 4),
                    Wrap(
                      spacing: 6,
                      runSpacing: 4,
                      children: group.value.map((cat) => FilterChip(
                            label: Text(cat, style: const TextStyle(fontSize: 12)),
                            selected: _selectedCategories.contains(cat),
                            onSelected: (val) {
                              setState(() {
                                if (val) {
                                  _selectedCategories.add(cat);
                                } else {
                                  _selectedCategories.remove(cat);
                                }
                              });
                            },
                          )).toList(),
                    ),
                    const SizedBox(height: 8),
                  ],
                );
              }).toList(),
            ),
          ),
      ],
    );
  }

  // ---------- 货期选择按钮组 ----------
  Widget _buildDeliverySelection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          '货期要求',
          style: Theme.of(context).textTheme.titleSmall,
        ),
        const SizedBox(height: 8),
        ToggleButtons(
          isSelected: [_delivery == 'spot', _delivery == 'futures'],
          onPressed: (index) {
            setState(() {
              _delivery = index == 0 ? 'spot' : 'futures';
            });
          },
          borderRadius: BorderRadius.circular(8),
          constraints: const BoxConstraints(minWidth: 60, minHeight: 36),
          children: const [
            Text('现货'),
            Text('期货'),
          ],
        ),
      ],
    );
  }

  // ---------- 补充说明文本域 ----------
  Widget _buildNoteField() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          '补充说明（可选）',
          style: Theme.of(context).textTheme.titleSmall,
        ),
        const SizedBox(height: 8),
        TextField(
          controller: _noteController,
          maxLines: 4,
          maxLength: _maxNoteChars,
          decoration: InputDecoration(
            hintText: '例如：需要环保认证、指定克重等',
            border: OutlineInputBorder(borderRadius: BorderRadius.circular(8)),
            counterText: '${_noteController.text.length}/$_maxNoteChars',
            counterStyle: Theme.of(context).textTheme.bodySmall,
          ),
          onChanged: (value) {
            setState(() {
              _noteCharCount = value.length;
            });
          },
        ),
      ],
    );
  }

  // ---------- 操作按钮组 ----------
  Widget _buildActionButtons() {
    return Row(
      children: [
        Expanded(
          child: OutlinedButton(
            onPressed: () {
              // 取消：返回上一页或清空
              Navigator.of(context).pop();
            },
            child: const Text('取消'),
          ),
        ),
        const SizedBox(width: 16),
        Expanded(
          child: FilledButton(
            onPressed: () {
              // 提交：校验后弹成功弹窗
              if (_uploadedImages.isEmpty) {
                _showSnackBar('请至少上传一张面料图片');
                return;
              }
              if (_cropRegion == null) {
                _showSnackBar('请选择找料区域');
                return;
              }
              _showSuccessDialog(context);
            },
            child: const Text('提交'),
          ),
        ),
      ],
    );
  }

  // ---------- 辅助提示文字 ----------
  Widget _buildHelperText() {
    return Text(
      '提示：提交后将在平台发布需求，匹配的供应商会主动联系您。',
      style: Theme.of(context).textTheme.bodySmall?.copyWith(color: Theme.of(context).colorScheme.outline),
    );
  }

  // ---------- 工具方法 ----------
  void _showSnackBar(String message) {
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message)));
  }

  // ---------- 弹窗：成功提示 ----------
  void _showSuccessDialog(BuildContext context) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Icon(Icons.check_circle, color: Colors.green, size: 60),
            const SizedBox(height: 16),
            Text(
              '发布成功！',
              style: Theme.of(context).textTheme.titleMedium?.copyWith(fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 8),
            Text(
              '您的面料需求已成功发布，供应商会尽快联系您。',
              textAlign: TextAlign.center,
              style: Theme.of(context).textTheme.bodyMedium,
            ),
            const SizedBox(height: 24),
            FilledButton(
              onPressed: () {
                Navigator.of(context).pop(); // 关闭弹窗
                // 可选：清空表单或返回
              },
              child: const Text('确认'),
            ),
          ],
        ),
      ),
    );
  }

  // ---------- 弹窗：画布裁剪 ----------
  // 模拟简单裁剪弹窗，实际应包含图片预览、虚线选框、拖拽缩放等
  void _showCropDialog(BuildContext context) {
    // 使用临时变量
    _tempCropRegion = _cropRegion;
    showDialog(
      context: context,
      builder: (ctx) {
        return StatefulBuilder(builder: (context, setDialogState) {
          return AlertDialog(
            title: const Text('裁剪区域'),
            content: SizedBox(
              width: 300,
              height: 300,
              child: Column(
                children: [
                  // 模拟图片预览（使用占位）
                  Container(
                    width: 200,
                    height: 200,
                    decoration: BoxDecoration(
                      color: Colors.grey[300],
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Center(
                      child: _tempCropRegion == null
                          ? const Text('请框选区域', style: TextStyle(color: Colors.black45))
                          : Text(
                              '区域: (${_tempCropRegion!.x1.toStringAsFixed(0)},${_tempCropRegion!.y1.toStringAsFixed(0)}) - (${_tempCropRegion!.x2.toStringAsFixed(0)},${_tempCropRegion!.y2.toStringAsFixed(0)})',
                              style: const TextStyle(color: Colors.black87),
                            ),
                    ),
                  ),
                  const SizedBox(height: 12),
                  // 模拟拖拽缩放控件（仅模拟）
                  Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      IconButton(
                        icon: const Icon(Icons.zoom_out),
                        onPressed: () {},
                        tooltip: '缩小',
                      ),
                      const Text('100%'),
                      IconButton(
                        icon: const Icon(Icons.zoom_in),
                        onPressed: () {},
                        tooltip: '放大',
                      ),
                    ],
                  ),
                  // 模拟虚线选框按钮（实际应拖动缩放，这里只是示例）
                  TextButton.icon(
                    onPressed: () {
                      // 随机生成一个区域模拟框选
                      final random = Random();
                      setDialogState(() {
                        _tempCropRegion = CropRegion(
                          x1: random.nextDouble() * 100,
                          y1: random.nextDouble() * 100,
                          x2: random.nextDouble() * 100 + 50,
                          y2: random.nextDouble() * 100 + 50,
                        );
                      });
                    },
                    icon: const Icon(Icons.crop_square),
                    label: const Text('模拟框选'),
                  ),
                  // 裁剪坐标信息
                  if (_tempCropRegion != null)
                    Text(
                      '坐标信息: (${_tempCropRegion!.x1.toStringAsFixed(1)}, ${_tempCropRegion!.y1.toStringAsFixed(1)}) -> (${_tempCropRegion!.x2.toStringAsFixed(1)}, ${_tempCropRegion!.y2.toStringAsFixed(1)})',
                      style: Theme.of(context).textTheme.bodySmall,
                    ),
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: () {
                  Navigator.of(ctx).pop();
                },
                child: const Text('取消'),
              ),
              FilledButton(
                onPressed: () {
                  // 确定：将临时变量赋值给_cropRegion
                  setState(() {
                    _cropRegion = _tempCropRegion;
                  });
                  Navigator.of(ctx).pop();
                },
                child: const Text('确定'),
              ),
            ],
          );
        });
      },
    );
  }

  // ---------- 弹窗：品类多选（实际在页面内已实现，但DSL要求弹窗，此处单独实现一个弹窗版本） ----------
  // 由于品类选择已通过展开方式实现弹窗效果，但DSL要求“品类多选弹窗（分类折叠面板...）”，我们另外提供一个弹窗
  void _showCategoryDialog(BuildContext context) {
    _tempSelectedCategories = List.from(_selectedCategories);
    showDialog(
      context: context,
      builder: (ctx) {
        return StatefulBuilder(builder: (context, setDialogState) {
          return AlertDialog(
            title: const Text('选择品类'),
            content: SizedBox(
              width: 300,
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  // 分类折叠面板（简化：直接展开所有类别）
                  ..._categoryGroups.entries.map((group) {
                    return ExpansionTile(
                      title: Text(group.key),
                      initiallyExpanded: true,
                      children: [
                        Wrap(
                          spacing: 6,
                          runSpacing: 4,
                          children: group.value.map((cat) => FilterChip(
                                label: Text(cat, style: const TextStyle(fontSize: 12)),
                                selected: _tempSelectedCategories.contains(cat),
                                onSelected: (val) {
                                  setDialogState(() {
                                    if (val) {
                                      _tempSelectedCategories.add(cat);
                                    } else {
                                      _tempSelectedCategories.remove(cat);
                                    }
                                  });
                                },
                              )).toList(),
                        ),
                      ],
                    );
                  }).toList(),
                ],
              ),
            ),
            actions: [
              TextButton(
                onPressed: () {
                  Navigator.of(ctx).pop();
                },
                child: const Text('取消'),
              ),
              FilledButton(
                onPressed: () {
                  setState(() {
                    _selectedCategories = List.from(_tempSelectedCategories);
                  });
                  Navigator.of(ctx).pop();
                },
                child: const Text('确定'),
              ),
            ],
          );
        });
      },
    );
  }
}

// 辅助类：裁剪区域
class CropRegion {
  final double x1, y1, x2, y2;
  CropRegion({required this.x1, required this.y1, required this.x2, required this.y2});
}
