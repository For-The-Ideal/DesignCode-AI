  }

  // ---------- 操作按钮组 ----------
  Widget _buildActionButtons() {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceEvenly,
      children: [
        OutlinedButton(
          onPressed: () => Navigator.of(context).pop(),
          child: const Text('取消'),
        ),
        ElevatedButton(
          onPressed: _submit,
          child: const Text('提交'),
        ),
      ],
    );
  }

  // ---------- 成功提示弹窗 ----------
  Widget _buildSuccessState() {
    // 成功页面也可以直接显示在 body，但 DSL 要求弹窗，所以触发弹窗后显示一个简单页面
    return Center(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          const Icon(Icons.check_circle, color: Colors.green, size: 80),
          const SizedBox(height: 16),
          const Text('需求发布成功', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold)),
          const SizedBox(height: 8),
          const Text('我们会尽快为您匹配合适的供应商'),
          const SizedBox(height: 24),
          ElevatedButton(
            onPressed: () {
              setState(() {
                _showSuccessDialog = false;
                // 重置状态回到初始
                _currentStep = 0;
                _uploadedImages.clear();
                _selectedRegion = '';
                _selectedCategories.clear();
                _deliveryOption = null;
                _remarkController.clear();
                _similarityOption = '100%一致';
              });
            },
            child: const Text('确定'),
          ),
        ],
      ),
    );
  }

  // ---------- 面料区域框选交互面板（模拟） ----------
  // 作为覆盖层显示在屏幕上方
  Widget? _buildRegionPanel() {
    if (!_showRegionPanel) return null;
    return Stack(
      children: [
        // 遮罩
        ModalBarrier(dismissible: false, color: Colors.black54),
        // 面板内容
        Center(
          child: Card(
            margin: const EdgeInsets.all(24),
            child: Padding(
              padding: const EdgeInsets.all(16),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const Text('框选找料区域', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                  const SizedBox(height: 16),
                  // 模拟图像预览 + 裁剪框
                  Container(
                    width: 280,
                    height: 200,
                    decoration: BoxDecoration(
                      color: Colors.blueGrey[200],
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: Stack(
                      children: [
                        // 图片占位
                        Center(child: Text('面料图像预览', style: TextStyle(color: Colors.grey[600]))),
                        // 模拟裁剪框
                        Positioned(
                          left: _cropX * 280,
                          top: _cropY * 200,
                          child: Container(
                            width: _cropWidth * 280,
                            height: _cropHeight * 200,
                            decoration: BoxDecoration(
                              border: Border.all(color: Colors.blue, width: 2),
                              color: Colors.blue.withOpacity(0.1),
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                  const SizedBox(height: 8),
                  // 坐标信息
                  Text(_cropInfo, style: const TextStyle(fontSize: 12)),
                  const SizedBox(height: 8),
                  // 模拟调整按钮（简化）
                  Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      ElevatedButton(
                        onPressed: () {
                          // 模拟随机调整裁剪框
                          final rng = Random();
                          _cropX = 0.1 + rng.nextDouble() * 0.3;
                          _cropY = 0.1 + rng.nextDouble() * 0.3;
                          _cropWidth = 0.4 + rng.nextDouble() * 0.4;
                          _cropHeight = 0.4 + rng.nextDouble() * 0.4;
                          setState(() {
                            _cropInfo = 'X: ${(_cropX*100).toStringAsFixed(0)}%  '
                                'Y: ${(_cropY*100).toStringAsFixed(0)}%  '
                                'W: ${(_cropWidth*100).toStringAsFixed(0)}%  '
                                'H: ${(_cropHeight*100).toStringAsFixed(0)}%';
                          });
                        },
                        child: const Text('模拟调整'),
                      ),
                    ],
                  ),
                  const SizedBox(height: 16),
                  // 取消 / 确定按钮
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                    children: [
                      TextButton(
                        onPressed: () => setState(() => _showRegionPanel = false),
                        child: const Text('取消'),
                      ),
                      ElevatedButton(
                        onPressed: _onRegionSelected,
                        child: const Text('确定'),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ),
        ),
      ],
    );
  }

  // ---------- 面料品类多选弹窗 ----------
  // 作为独立弹窗（使用showDialog实现）
  @override
  Widget build(BuildContext context) {
    // 重写build以包含品类弹窗
    final content = super.build(context);
    if (_showCategoryDialog) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        _showCategoryDialogFunc();
      });
    }
    return content;
  }

  void _showCategoryDialogFunc() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            return AlertDialog(
              title: const Text('选择面料品类'),
              content: SizedBox(
                width: double.maxFinite,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    // 分组标题（简化：所有品类一组）
                    const Text('所有面料（可多选）'),
                    const SizedBox(height: 8),
                    Flexible(
                      child: ListView(
                        shrinkWrap: true,
                        children: _availableCategories.map((cat) {
                          return CheckboxListTile(
                            title: Text(cat),
                            value: _categoryCheckState[cat] ?? false,
                            onChanged: (value) {
                              setDialogState(() {
                                _categoryCheckState[cat] = value!;
                              });
                            },
                          );
                        }).toList(),
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () {
                    setState(() => _showCategoryDialog = false);
                    Navigator.of(context).pop();
                  },
                  child: const Text('取消'),
                ),
                ElevatedButton(
                  onPressed: () {
                    // 收集选中的品类
                    final selected = _availableCategories
                        .where((cat) => _categoryCheckState[cat] == true)
                        .toList();
                    _onCategoriesConfirmed(selected);
                    Navigator.of(context).pop();
                  },
                  child: const Text('确定'),
                ),
              ],
            );
          },
        );
      },
    );
    // 重置标记，防止重复调用
    _showCategoryDialog = false;
  }
}
