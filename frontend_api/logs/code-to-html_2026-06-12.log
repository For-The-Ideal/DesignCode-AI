    if (_uploadedImages.length < _maxImages) {
      setState(() {
        _uploadedImages.add(imageColor);
        // 添加图片后自动进入步骤1（如果还在步骤0）
        if (_currentStep == 0) _currentStep = 1;
      });
    }
  }

  void _removeImage(int index) {
    setState(() {
      _uploadedImages.removeAt(index);
      // 如果没有图片了，回到步骤0
      if (_uploadedImages.isEmpty) _currentStep = 0;
    });
  }

  void _onRegionSelected() {
    setState(() {
      _selectedRegion = _cropInfo;
      _showRegionPanel = false;
    });
  }

  void _onCategoriesConfirmed(List<String> selected) {
    setState(() {
      _selectedCategories.clear();
      _selectedCategories.addAll(selected);
      _showCategoryDialog = false;
    });
  }

  void _submit() {
    // 简单验证：至少1张图片、区域已选、品类至少一个、货期已选
    if (_uploadedImages.isEmpty) {
      _showSnackBar('请至少上传1张面料图片');
      return;
    }
    if (_selectedRegion.isEmpty) {
      _showSnackBar('请框选找料区域');
      return;
    }
    if (_selectedCategories.isEmpty) {
      _showSnackBar('请选择至少一个品类');
      return;
    }
    if (_deliveryOption == null) {
      _showSnackBar('请选择货期');
      return;
    }
    // 提交成功
    setState(() {
      _currentStep = 2;
      _showSuccessDialog = true;
    });
  }

  void _showSnackBar(String message) {
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message)));
  }

  // ---------- Build ----------
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('我要找料'),
        leading: IconButton(
          icon: const Icon(Icons.close),
          onPressed: () => Navigator.of(context).pop(),
        ),
      ),
      body: SafeArea(
        child: _currentStep == 0
            ? _buildEmptyState()
            : _currentStep == 1
                ? _buildFormContent()
                : _buildSuccessState(),
      ),
      // 独立功能弹窗
      floating: _buildRegionPanel(),
      // 品类多选弹窗
      floatingActionButton: null, // 不显示fab
    );
  }

  // ---------- 空状态占位组件（两个‘+ 上传面料’卡片） ----------
  Widget _buildEmptyState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Text(
            '上传面料图片开始找料',
            style: Theme.of(context).textTheme.titleMedium,
          ),
          const SizedBox(height: 24),
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: List.generate(
              2,
              (index) => Padding(
                padding: const EdgeInsets.symmetric(horizontal: 12),
                child: GestureDetector(
                  onTap: () => _addImage(
                    Colors.primaries[Random().nextInt(Colors.primaries.length)],
                  ),
                  child: Container(
                    width: 140,
                    height: 160,
                    decoration: BoxDecoration(
                      color: Colors.grey[200],
                      borderRadius: BorderRadius.circular(16),
                      border: Border.all(color: Colors.grey[400]!),
                    ),
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Icon(Icons.add_photo_alternate_outlined, size: 40, color: Colors.grey[600]),
                        const SizedBox(height: 8),
                        Text('上传面料', style: TextStyle(color: Colors.grey[600])),
                      ],
                    ),
                  ),
                ),
              ),
            ),
          ),
          const SizedBox(height: 16),
          Text(
            '点击卡片上传面料图片',
            style: Theme.of(context).textTheme.bodySmall,
          ),
        ],
      ),
    );
  }

  // ---------- 步骤引导说明文本 ----------
  Widget _buildStepIndicator() {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 16),
      child: Row(
        children: [
          _stepCircle(1, '上传图片', _uploadedImages.isNotEmpty),
          const SizedBox(width: 8),
          const Expanded(child: Divider()),
          const SizedBox(width: 8),
          _stepCircle(2, '填写需求', _selectedRegion.isNotEmpty &&
              _selectedCategories.isNotEmpty &&
              _deliveryOption != null),
          const SizedBox(width: 8),
          const Expanded(child: Divider()),
          const SizedBox(width: 8),
          _stepCircle(3, '提交', false),
        ],
      ),
    );
  }

  Widget _stepCircle(int number, String label, bool completed) {
    final bool active = (number == 1 && _uploadedImages.isNotEmpty) ||
        (number == 2 && completed) ||
        (number == 3);
    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        Container(
          width: 28,
          height: 28,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: active ? Colors.blue : Colors.grey[300],
          ),
          child: Center(
            child: completed
                ? const Icon(Icons.check, size: 18, color: Colors.white)
                : Text('$number', style: TextStyle(color: active ? Colors.white : Colors.grey[600])),
          ),
        ),
        const SizedBox(height: 4),
        Text(label, style: TextStyle(fontSize: 12, color: active ? Colors.blue : Colors.grey)),
      ],
    );
  }

  // ---------- 表单内容（步骤1） ----------
  Widget _buildFormContent() {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _buildStepIndicator(),
          const SizedBox(height: 16),

          // 1. 图片上传区域
          _buildImageUploadSection(),
          const SizedBox(height: 16),

          // 2. 区域选择按钮
          _buildRegionButton(),
          const SizedBox(height: 16),

          // 3. 相似度选择
          _buildSimilaritySelector(),
          const SizedBox(height: 16),

          // 4. 品类选择组件
          _buildCategorySelector(),
          const SizedBox(height: 16),

          // 5. 货期选择
          _buildDeliverySelector(),
          const SizedBox(height: 16),

          // 6. 补充说明
          _buildRemarkField(),
          const SizedBox(height: 24),

          // 7. 操作按钮
          _buildActionButtons(),
          const SizedBox(height: 32),
        ],
      ),
    );
  }

  // ---------- 图片上传区域 ----------
  Widget _buildImageUploadSection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text('上传面料图片 (1-3张)', style: Theme.of(context).textTheme.titleSmall),
        const SizedBox(height: 8),
        SizedBox(
          height: 100,
          child: ListView(
            scrollDirection: Axis.horizontal,
            children: [
              // 已有图片预览
              ..._uploadedImages.asMap().entries.map((entry) {
                int index = entry.key;
                Color color = entry.value;
                return Padding(
                  padding: const EdgeInsets.only(right: 12),
                  child: Stack(
                    children: [
                      Container(
                        width: 100,
                        height: 100,
                        decoration: BoxDecoration(
                          color: color,
                          borderRadius: BorderRadius.circular(8),
                          border: Border.all(color: Colors.grey[300]!),
                        ),
                      ),
                      Positioned(
                        top: 0,
                        right: 0,
                        child: GestureDetector(
                          onTap: () => _removeImage(index),
                          child: Container(
                            padding: const EdgeInsets.all(2),
                            decoration: const BoxDecoration(
                              color: Colors.black54,
                              shape: BoxShape.circle,
                            ),
                            child: const Icon(Icons.close, color: Colors.white, size: 16),
                          ),
                        ),
                      ),
                    ],
                  ),
                );
              }),
              // 添加图片按钮
              if (_uploadedImages.length < _maxImages)
                GestureDetector(
                  onTap: () => _addImage(
                    Colors.primaries[Random().nextInt(Colors.primaries.length)],
                  ),
                  child: Container(
                    width: 100,
                    height: 100,
                    decoration: BoxDecoration(
                      color: Colors.grey[200],
                      borderRadius: BorderRadius.circular(8),
                      border: Border.all(color: Colors.grey[300]!),
                    ),
                    child: const Icon(Icons.add, size: 32, color: Colors.grey),
                  ),
                ),
            ],
          ),
        ),
        Text('已上传 ${_uploadedImages.length}/$_maxImages 张', style: const TextStyle(fontSize: 12)),
      ],
    );
  }

  // ---------- 区域选择按钮 ----------
  Widget _buildRegionButton() {
    return Row(
      children: [
        const Text('找料区域：'),
        const SizedBox(width: 8),
        OutlinedButton.icon(
          onPressed: () {
            setState(() => _showRegionPanel = true);
          },
          icon: const Icon(Icons.crop),
          label: Text(_selectedRegion.isEmpty ? '框选找料区域' : '已选择区域 (点击修改)'),
        ),
        if (_selectedRegion.isNotEmpty)
          Padding(
            padding: const EdgeInsets.only(left: 8),
            child: Text(_selectedRegion, style: const TextStyle(fontSize: 11, color: Colors.grey)),
          ),
      ],
    );
  }

  // ---------- 相似度选择 ----------
  Widget _buildSimilaritySelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text('相似度要求'),
        const SizedBox(height: 8),
        SegmentedButton<String>(
          segments: const [
            ButtonSegment(value: '100%一致', label: Text('100%一致')),
            ButtonSegment(value: '相似即可', label: Text('相似即可')),
          ],
          selected: {_similarityOption},
          onSelectionChanged: (Set<String> selected) {
            setState(() => _similarityOption = selected.first);
          },
        ),
      ],
    );
  }

  // ---------- 品类选择组件 ----------
  Widget _buildCategorySelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text('面料品类'),
        const SizedBox(height: 8),
        Wrap(
          spacing: 8,
          runSpacing: 4,
          children: [
            ..._selectedCategories.map((cat) => Chip(
                  label: Text(cat),
                  onDeleted: () {
                    setState(() {
                      _selectedCategories.remove(cat);
                      _categoryCheckState[cat] = false;
                    });
                  },
                )),
            ActionChip(
              avatar: const Icon(Icons.add),
              label: const Text('点击选择'),
              onPressed: () {
                // 打开品类多选弹窗
                setState(() => _showCategoryDialog = true);
              },
            ),
          ],
        ),
        if (_selectedCategories.isEmpty)
          const Text('暂未选择品类', style: TextStyle(color: Colors.grey, fontSize: 12)),
      ],
    );
  }

  // ---------- 货期选择 ----------
  Widget _buildDeliverySelector() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text('货期要求'),
        const SizedBox(height: 8),
        Row(
          children: [
            ChoiceChip(
              label: const Text('现货'),
              selected: _deliveryOption == '现货',
              onSelected: (val) => setState(() => _deliveryOption = '现货'),
            ),
            const SizedBox(width: 12),
            ChoiceChip(
              label: const Text('期货'),
              selected: _deliveryOption == '期货',
              onSelected: (val) => setState(() => _deliveryOption = '期货'),
            ),
          ],
        ),
      ],
    );
  }

  // ---------- 补充说明文本域 ----------
  Widget _buildRemarkField() {
    return TextField(
      controller: _remarkController,
      maxLines: 3,
      maxLength: 500,
      decoration: const InputDecoration(
        labelText: '补充说明（选填）',
        hintText: '请输入其他要求...',
