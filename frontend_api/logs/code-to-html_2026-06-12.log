            ),
            const SizedBox(width: 12),
            if (_selectedRegionLabel != null)
              Chip(
                label: Text(_selectedRegionLabel!),
                onDeleted: () => setState(() => _selectedRegionLabel = null),
              ),
          ],
        ),
        const SizedBox(height: 24),
        // 相似度选项卡
        Text('相似度', style: Theme.of(context).textTheme.titleSmall),
        const SizedBox(height: 8),
        SegmentedButton<String>(
          segments: const [
            ButtonSegment(value: '100%一致', label: Text('100%一致')),
            ButtonSegment(value: '相似即可', label: Text('相似即可')),
          ],
          selected: {_similarity},
          onSelectionChanged: (Set<String> selected) {
            setState(() {
              _similarity = selected.first;
