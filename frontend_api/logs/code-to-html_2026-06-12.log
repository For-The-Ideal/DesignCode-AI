                    ),
                  ),
                ),
              ),
            ],
          );
        },
      ),
    );
  }
}

// 波浪线背景
class WaveBackgroundPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.indigo.withOpacity(0.08)
      ..strokeWidth = 2.0
      ..style = PaintingStyle.stroke;

    for (int i = 0; i < 5; i++) {
      final offsetY = size.height * (0.15 + 0.17 * i);
      final path = Path();
      path.moveTo(0, offsetY);
      for (double x = 0; x <= size.width; x += 1) {
        final y = offsetY + 12 * sin((x / size.width) * 4 * pi + i * pi / 3);
        path.lineTo(x, y);
      }
      canvas.drawPath(path, paint);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

// 用户轮廓（女性侧脸剪影）
class UserProfileSilhouettePainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.indigo
      ..style = PaintingStyle.fill;

    final path = Path();
    final w = size.width;
    final h = size.height;

    // 从头顶开始，脸朝向右侧
    path.moveTo(w * 0.35, h * 0.02);
    // 额头
    path.quadraticBezierTo(w * 0.55, h * 0.05, w * 0.60, h * 0.15);
    // 鼻梁
    path.quadraticBezierTo(w * 0.72, h * 0.20, w * 0.75, h * 0.28);
    // 鼻尖
    path.quadraticBezierTo(w * 0.78, h * 0.32, w * 0.76, h * 0.35);
    // 上唇
    path.quadraticBezierTo(w * 0.70, h * 0.37, w * 0.70, h * 0.40);
    // 下唇和下巴
    path.quadraticBezierTo(w * 0.72, h * 0.43, w * 0.68, h * 0.48);
    // 下巴尖
    path.quadraticBezierTo(w * 0.62, h * 0.55, w * 0.55, h * 0.58);
    // 脖子
    path.lineTo(w * 0.50, h * 0.62);
    // 后脑勺
    path.quadraticBezierTo(w * 0.30, h * 0.50, w * 0.25, h * 0.35);
    path.quadraticBezierTo(w * 0.22, h * 0.20, w * 0.25, h * 0.08);
    path.quadraticBezierTo(w * 0.30, h * 0.02, w * 0.35, h * 0.02);
    path.close();

    canvas.drawPath(path, paint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

// 手持放大镜
class MagnifyingGlassPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.indigo
      ..style = PaintingStyle.stroke
      ..strokeWidth = 4.0
      ..strokeCap = StrokeCap.round;

    // 镜片（圆）
    final center = Offset(size.width / 2, size.height / 2);
    final radius = size.width * 0.22;
    canvas.drawCircle(center, radius, paint);

    // 手柄（斜线）
    final handleStart = Offset(
      center.dx + radius * 0.707,
      center.dy + radius * 0.707,
    );
    final handleEnd = Offset(
      center.dx + radius * 1.5,
      center.dy + radius * 1.5,
    );
    canvas.drawLine(handleStart, handleEnd, paint);
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
