                          }),
                        ],
                      );
                    }).toList(),
                  ),
                ),
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.of(context).pop(),
                  child: const Text('取消'),
                ),
                ElevatedButton(
                  onPressed: () {
                    setState(() {
                      _selectedCategories = tempSelected;
                    });
                    Navigator.of(context).pop();
                  },
                  child: const Text('确定'),
                ),
              ],
            );
          },
        );
      },
    );
  }

  // 步骤3: 货期与补充说明
  Widget _buildDeliveryAndNoteStep() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text('货期', style: Theme.of(context).textTheme.titleSmall),
        const SizedBox(height: 8),
        SegmentedButton<String>(
          segments: const [
            ButtonSegment(value: '现货', label: Text('现货')),
            ButtonSegment(value: '期货', label: Text('期货')),
          ],
          selected: {_delivery},
          onSelectionChanged: (Set<String> selected) {
            setState(() {
              _delivery = selected.first;
            });
          },
        ),
        const SizedBox(height: 24),
        Text('补充说明', style: Theme.of(context).textTheme.titleSmall),
        const SizedBox(height: 8),
        TextField(
          controller: _noteController,
          maxLines: 4,
          maxLength: 200,
          decoration: const InputDecoration(
            hintText: '请输入补充说明，如特殊要求...',
            border: OutlineInputBorder(),
          ),
        ),
      ],
    );
  }

  // 步骤4: 确认提交
  Widget _buildConfirmStep() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _buildConfirmItem('图片数量', '${_images.length} 张'),
        _buildConfirmItem('区域选择', _selectedRegionLabel ?? '未选择'),
        _buildConfirmItem('相似度', _similarity),
        _buildConfirmItem('品类', _selectedCategories.isEmpty ? '未选择' : _selectedCategories.join(', ')),
        _buildConfirmItem('货期', _delivery),
        if (_noteController.text.isNotEmpty)
          _buildConfirmItem('补充说明', _noteController.text),
      ],
    );
  }

  Widget _buildConfirmItem(String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 4),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          SizedBox(
            width: 80,
            child: Text('$label：', style: const TextStyle(fontWeight: FontWeight.w500)),
          ),
          Expanded(child: Text(value)),
        ],
      ),
    );
  }

  // 底部导航按钮（上下一步/取消提交）
  Widget _buildBottomNavigation() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
      decoration: BoxDecoration(
        border: Border(top: BorderSide(color: Theme.of(context).colorScheme.outlineVariant)),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          if (_currentStep > 0)
            TextButton(
              onPressed: () {
                setState(() {
                  _currentStep--;
                });
              },
              child: const Text('上一步'),
            )
          else
            const SizedBox.shrink(),
          if (_currentStep < _totalSteps - 1)
            ElevatedButton(
              onPressed: () {
                setState(() {
                  _currentStep++;
                });
              },
              child: const Text('下一步'),
            )
          else
            Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextButton(
                  onPressed: () {
                    // 取消，可返回或重置
                    Navigator.of(context).pop();
                  },
                  child: const Text('取消'),
                ),
                const SizedBox(width: 12),
                ElevatedButton(
                  onPressed: () {
                    // 提交后显示成功弹窗
                    _showSuccessDialog = true;
                    showDialog(
                      context: context,
                      barrierDismissible: false,
                      builder: (context) => _buildSuccessDialog(),
                    );
                  },
                  child: const Text('提交'),
                ),
              ],
            ),
        ],
      ),
    );
  }

  // 成功弹窗
  Widget _buildSuccessDialog() {
    return AlertDialog(
      content: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(
            Icons.check_circle_outline,
            size: 64,
            color: Theme.of(context).colorScheme.primary,
          ),
          const SizedBox(height: 16),
          const Text('需求发布成功！', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
          const SizedBox(height: 8),
          const Text('我们的客服将在24小时内与您联系，确认样品寄送与报价。'),
          const SizedBox(height: 16),
          ElevatedButton(
            onPressed: () {
              Navigator.of(context).pop(); // 关闭弹窗
              setState(() {
                _resetForm();
              });
            },
            child: const Text('确认'),
          ),
        ],
      ),
    );
  }

  void _resetForm() {
    _images.clear();
    _selectedRegionLabel = null;
    _similarity = '100%一致';
    _selectedCategories.clear();
    _delivery = '现货';
    _noteController.clear();
    _currentStep = 0;
  }
}

// 辅助类
class _CategoryGroup {
  final String name;
  final List<String> items;
  const _CategoryGroup({required this.name, required this.items});
}
