                  height: 80,
                  decoration: BoxDecoration(
                    color: hasImage ? Colors.transparent : Colors.grey.shade100,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(
                      color: hasImage ? Colors.transparent : Colors.grey.shade400,
                    ),
                  ),
                  child: hasImage
                      ? ClipRRect(
                          borderRadius: BorderRadius.circular(12),
                          child: Image.network(
