  }
}

class FabricRequestFormPage extends StatefulWidget {
  const FabricRequestFormPage({super.key});

  @override
  State<FabricRequestFormPage> createState() => _FabricRequestFormPageState();
}

class _FabricRequestFormPageState extends State<FabricRequestFormPage> {
  int _currentStep = 0;
  final int _totalSteps = 5;

  // 图片上传相关
  List<String> _images = [];
  static const int _maxImages = 3;

  // 区域框选相关 (简单模拟)
  String? _selectedRegionLabel;

  // 相似度
  String _similarity = '100%一致'; // 或 '相似即可'

  // 品类选择
  List<String> _selectedCategories = [];
  // 模拟品类数据
  final List<_CategoryGroup> _categoryGroups = [
    _CategoryGroup(
      name: '棉类',
