                          ...group.items.map((item) {
                            final isChecked = tempSelected.contains(item);
                            return CheckboxListTile(
                              value: isChecked,
                              onChanged: (bool? value) {
                                setDialogState(() {
                                  if (value == true) {
                                    tempSelected.add(item);
                                  } else {
                                    tempSelected.remove(item);
                                  }
                                });
                              },
                              title: Text(item),
                              controlAffinity: ListTileControlAffinity.leading,
