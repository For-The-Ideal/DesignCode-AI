<script setup lang="ts">
import { ref } from 'vue'

// 定义 props（控制显示隐藏）
const props = withDefaults(defineProps<{
  visible?: boolean
}>(), {
  visible: false
})

// 定义 emits
const emit = defineEmits<{
  (e: 'update:visible', value: boolean): void
  (e: 'back'): void
  (e: 'upload'): void
  (e: 'generate', playIndex: number): void
  (e: 'close'): void
}>()

// 本地显示状态（受控于 prop）
const isVisible = ref(props.visible)

// 当 prop 变化时同步本地状态
import { watch } from 'vue'
watch(() => props.visible, (newVal) => {
  isVisible.value = newVal
})

// 玩法选项
const playOptions = [
  { label: '生成同花型系列款' },
  { label: '毛衫改款延伸' },
  { label: '参考品牌风格植入' },
  { label: '领型样式创新' },
  { label: '毛衫织法延申' },
  { label: '单品不同搭配建议' }
]

// 当前选中的玩法（索引）
const selectedPlay = ref<number | null>(null)

// 选择玩法
function selectPlay(index: number) {
  selectedPlay.value = index
}

// 返回
function handleBack() {
  emit('back')
}

// 关闭
function handleClose() {
  emit('close')
  emit('update:visible', false)
}

// 上传（点击加号）
function handleUpload() {
  emit('upload')
}

// 开始生成
function handleGenerate() {
  if (selectedPlay.value !== null) {
    emit('generate', selectedPlay.value)
  }
}
</script>

