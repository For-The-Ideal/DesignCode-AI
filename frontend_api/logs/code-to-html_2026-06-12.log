class _CategoryMultiSelectDialog extends StatefulWidget {
  final List<String> initialSelected;
  final Function(List<String>) onConfirm;
  const _CategoryMultiSelectDialog(
      {required this.initialSelected, required this.onConfirm});

  @override
  State<_CategoryMultiSelectDialog> createState() =>
      _CategoryMultiSelectDialogState();
}

class _CategoryMultiSelectDialogState
    extends State<_CategoryMultiSelectDialog> {
  late List<String> _selected;

  // 模拟分组数据
  final Map<String, List<String>> _categories = {
    '所有牛仔': ['牛仔蓝', '水洗牛仔', '弹力牛仔'],
    '所有混纺': ['涤棉混纺', '粘胶混纺', '羊毛混纺'],
    '所有棉': ['纯棉', '棉麻', '棉涤'],
    '其他': ['针织', '梭织', '功能面料'],
  };

  @override
  void initState() {
    super.initState();
    _selected = List.from(widget.initialSelected);
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: const Text('选择面料品类'),
      content: SizedBox(
        width: MediaQuery.of(context).size.width * 0.7,
        height: 400,
        child: ListView(
          children: _categories.entries.map((entry) {
            return ExpansionTile(
              title: Text(entry.key,
                  style: Theme.of(context).textTheme.titleSmall),
              initiallyExpanded: true,
              children: entry.value.map((item) {
                final isChecked = _selected.contains(item);
                return CheckboxListTile(
                  title: Text(item),
                  value: isChecked,
                  onChanged: (v) {
                    setState(() {
                      if (v == true) {
                        _selected.add(item);
                      } else {
                        _selected.remove(item);
                      }
                    });
                  },
                );
              }).toList(),
            );
          }).toList(),
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.of(context).pop(),
          child: const Text('取消'),
        ),
        FilledButton(
          onPressed: () {
            widget.onConfirm(_selected);
            Navigator.of(context).pop();
          },
          child: const Text('确定'),
        ),
      ],
    );
  }
}

