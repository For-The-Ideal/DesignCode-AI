  // 底部推荐模型与实践建议区
  Widget _buildRecommendationSection(BuildContext context, bool isWide) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text('推荐模型与实践建议', style: Theme.of(context).textTheme.titleLarge?.copyWith(fontWeight: FontWeight.bold)),
