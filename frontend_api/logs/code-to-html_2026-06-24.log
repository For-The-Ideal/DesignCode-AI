          return Center(
            child: CustomPaint(
              size: size,
              painter: HandDrawnArcPainter(
                arcWidth: size.width * 0.6,
                arcHeight: size.height * 0.3,
              ),
            ),
          );
        },
      ),
    );
  }
}

class HandDrawnArcPainter extends CustomPainter {
  final double arcWidth;
  final double arcHeight;

  HandDrawnArcPainter({
    this.arcWidth = 300,
    this.arcHeight = 150,
  });

  @override
  void paint(Canvas canvas, Size size) {
    // 定义弧线的范围
    final centerX = size.width / 2;
    final centerY = size.height / 2;
    final left = centerX - arcWidth / 2;
    final right = centerX + arcWidth / 2;
    final top = centerY - arcHeight / 2;
    final bottom = centerY + arcHeight / 2;

    // 生成弧线上的点（拱形，类似微笑曲线）
    const pointCount = 60;
    final random = Random(42); // 固定种子保证手绘效果一致
    final points = <Offset>[];

    for (int i = 0; i <= pointCount; i++) {
      final t = i / pointCount;
      final x = left + t * arcWidth;
      // 抛物线形式：y = top + 4 * (t - 0.5)^2 * arcHeight
      // 向下弯曲，所以顶部在中间
      final y = top + 4 * pow(t - 0.5, 2) * arcHeight;
      // 添加手绘抖动
      final jitterX = (random.nextDouble() - 0.5) * 3.0;
      final jitterY = (random.nextDouble() - 0.5) * 3.0;
      points.add(Offset(x + jitterX, y + jitterY));
    }

    // 创建主路径
    final mainPath = Path();
    mainPath.moveTo(points[0].dx, points[0].dy);
    for (int i = 1; i < points.length; i++) {
      mainPath.lineTo(points[i].dx, points[i].dy);
    }

    // 绘制数条抖动副本，营造手绘多重线效果
    final basePaint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.5
      ..isAntiAlias = true;

    // 主色深灰
    canvas.drawPath(
      mainPath,
      basePaint..color = Colors.grey[700]!,
    );

    // 稍浅的偏移副本
    final offsetPaths = <Path>[];
    for (int layer = 0; layer < 3; layer++) {
      final path = Path();
      // 重新生成随机抖动（使用不同种子）
      final rng = Random(42 + layer);
      final pts = <Offset>[];
      for (int i = 0; i <= pointCount; i++) {
        final t = i / pointCount;
        final x = left + t * arcWidth;
        final y = top + 4 * pow(t - 0.5, 2) * arcHeight;
        final jitterX = (rng.nextDouble() - 0.5) * 4.0;
        final jitterY = (rng.nextDouble() - 0.5) * 4.0;
        pts.add(Offset(x + jitterX, y + jitterY));
      }
      path.moveTo(pts[0].dx, pts[0].dy);
      for (int i = 1; i < pts.length; i++) {
        path.lineTo(pts[i].dx, pts[i].dy);
      }
      canvas.drawPath(
        path,
        basePaint
          ..color = Colors.grey.withOpacity(0.3 + layer * 0.1)
          ..strokeWidth = 0.5 + layer * 0.3,
      );
    }

    // 添加一些短小的装饰线段，模拟铅笔素描的质感
    final tinyPaint = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 0.8
      ..color = Colors.grey[400]!;
    for (int i = 0; i < 30; i++) {
      final rng = Random(100 + i);
      final t = rng.nextDouble();
      final x = left + t * arcWidth;
      final y = top + 4 * pow(t - 0.5, 2) * arcHeight;
      final angle = rng.nextDouble() * 2 * pi;
      final length = 2.0 + rng.nextDouble() * 4.0;
      final dx = cos(angle) * length;
      final dy = sin(angle) * length;
      canvas.drawLine(
        Offset(x, y),
        Offset(x + dx, y + dy),
        tinyPaint,
      );
    }
  }

  @override
  bool shouldRepaint(covariant HandDrawnArcPainter oldDelegate) {
    return oldDelegate.arcWidth != arcWidth || oldDelegate.arcHeight != arcHeight;
  }
}
