      {'icon': Icons.analytics, 'title': '步骤5', 'desc': '差异分析结果\n(JSON结构化差异报告、相似度与差异项统计)'},
      {'icon': Icons.autorenew, 'title': '步骤6', 'desc': '自动优化迭代\n(修复操作列表、循环迭代箭头)'},
    ];

    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
