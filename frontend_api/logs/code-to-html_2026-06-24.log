/// Paints a stylized 4‑petal flower / heart motif.
class FourPetalFlowerPainter extends CustomPainter {
  final Color color;

  FourPetalFlowerPainter({required this.color});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.fill;

    final center = Offset(size.width / 2, size.height / 2);
    final radius = size.width / 4;

    // Draw 4 petals at 0°, 90°, 180°, 270°
    for (int i = 0; i < 4; i++) {
      final angle = i * (3.1415926535 / 2);
      final petalCenter = Offset(
        center.dx + radius * 0.7 * cos(angle),
        center.dy + radius * 0.7 * sin(angle),
      );

      // Each petal is a rounded rect / heart shape approximated by an oval
      final rect = Rect.fromCenter(
        center: petalCenter,
        width: radius * 1.2,
        height: radius * 1.2,
      );
      canvas.drawOval(rect, paint);
    }

    // Central circle
    canvas.drawCircle(center, radius * 0.35, paint);
  }

  @override
  bool shouldRepaint(covariant FourPetalFlowerPainter oldDelegate) =>
      oldDelegate.color != color;
}

/// Paints a stylized maple leaf silhouette.
/// Approximated by a 5‑pointed leaf shape.
class MapleLeafPainter extends CustomPainter {
  final Color color;

  MapleLeafPainter({required this.color});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..style = PaintingStyle.fill
      ..strokeWidth = 2;

    final path = Path();
    final w = size.width;
    final h = size.height;
    final cx = w / 2;
    final cy = h / 2;

    // Draw a simple maple‑like shape using bezier curves
    // Starting from bottom center
    path.moveTo(cx, h - 0.15 * h);

    // Left lobe
    path.cubicTo(
      cx - 0.1 * w, h - 0.2 * h,
      cx - 0.35 * w, h - 0.45 * h,
      cx - 0.25 * w, h - 0.55 * h,
    );
    // Top left
    path.cubicTo(
      cx - 0.2 * w, h - 0.6 * h,
      cx - 0.3 * w, h - 0.75 * h,
      cx - 0.2 * w, h - 0.7 * h,
    );
    // Upper left
    path.cubicTo(
      cx - 0.15 * w, h - 0.75 * h,
      cx - 0.2 * w, h - 0.85 * h,
      cx - 0.1 * w, h - 0.8 * h,
    );
    // Top point
    path.cubicTo(
      cx - 0.05 * w, h - 0.85 * h,
      cx, h - 0.95 * h,
      cx + 0.05 * w, h - 0.85 * h,
    );
    // Upper right
    path.cubicTo(
      cx + 0.2 * w, h - 0.85 * h,
      cx + 0.15 * w, h - 0.75 * h,
      cx + 0.2 * w, h - 0.7 * h,
    );
    // Top right
    path.cubicTo(
      cx + 0.3 * w, h - 0.75 * h,
      cx + 0.2 * w, h - 0.6 * h,
      cx + 0.25 * w, h - 0.55 * h,
    );
    // Right lobe
    path.cubicTo(
      cx + 0.35 * w, h - 0.45 * h,
      cx + 0.1 * w, h - 0.2 * h,
      cx + 0.15 * w, h - 0.15 * h,
    );
    // Bottom
    path.cubicTo(
      cx + 0.2 * w, h - 0.1 * h,
      cx + 0.1 * w, h - 0.05 * h,
      cx, h - 0.02 * h,
    );
    path.cubicTo(
      cx - 0.1 * w, h - 0.05 * h,
      cx - 0.2 * w, h - 0.1 * h,
      cx - 0.15 * w, h - 0.15 * h,
    );
    path.close();

    canvas.drawPath(path, paint);
  }

  @override
  bool shouldRepaint(covariant MapleLeafPainter oldDelegate) =>
      oldDelegate.color != color;
}
