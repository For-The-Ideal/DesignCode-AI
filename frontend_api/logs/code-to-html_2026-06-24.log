        // 使用 Row 并配合 Expanded 实现两个卡片并排，响应式自动调整间距
        Row(
          children: [
            Expanded(
              child: _buildTaskCard(
                context,
                icon: Icons.calendar_today,
                title: '每日签到',
                reward: '+10 灵感点',
                buttonText: _signedIn ? '已签到' : '签到',
                onPressed: () {
                  if (!_signedIn) {
                    setState(() => _signedIn = true);
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(content: Text('签到成功，获得10灵感点！')),
                    );
                  }
                },
                isDisabled: _signedIn,
              ),
