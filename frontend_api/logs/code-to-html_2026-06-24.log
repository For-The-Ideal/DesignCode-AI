  // 五阶段闭环流程图
  Widget _buildFlowChart(BuildContext context) {
    final phases = ['代码生成', '渲染', '对比', '分析', '优化'];
    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: Row(
        children: phases.asMap().entries.map((entry) {
          final index = entry.key;
          final phase = entry.value;
          return Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                decoration: BoxDecoration(
                  color: Theme.of(context).colorScheme.primaryContainer,
                  borderRadius: BorderRadius.circular(20),
                ),
                child: Text(phase, style: Theme.of(context).textTheme.bodyMedium?.copyWith(fontWeight: FontWeight.w500)),
              ),
              if (index < phases.length - 1)
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 4),
                  child: Icon(Icons.arrow_forward, size: 20, color: Theme.of(context).colorScheme.onSurfaceVariant),
                ),
            ],
          );
        }).toList(),
      ),
    );
  }

  // 四条最佳实践（带勾选标记）
  Widget _buildBestPractices(BuildContext context) {
    final practices = [
      '使用高分辨率设计图作为输入',
      '选择与框架匹配的模型（如Vue推荐使用sketch2vue）',
      '对比时启用结构感知评分',
      '迭代优化时设置合理停止条件',
    ];
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: practices.map((practice) {
        return Padding(
          padding: const EdgeInsets.symmetric(vertical: 4),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Icon(Icons.check_circle, color: Colors.green, size: 20),
              const SizedBox(width: 8),
              Expanded(child: Text(practice, style: Theme.of(context).textTheme.bodyMedium)),
            ],
          ),
        );
      }).toList(),
    );
  }

  // 核心结论提示框（灯泡图标+总结性文字）
  Widget _buildConclusionBox(BuildContext context) {
    return Card(
      color: Theme.of(context).colorScheme.secondaryContainer,
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Icon(Icons.lightbulb, size: 32, color: Theme.of(context).colorScheme.onSecondaryContainer),
            const SizedBox(width: 12),
            Expanded(
              child: Text(
                '核心结论：AI生成UI闭环通过自动代码生成、渲染对比和迭代优化，可显著提升设计到代码的转换效率，推荐结合混合评分模型进行质量评估。',
                style: Theme.of(context).textTheme.bodyLarge?.copyWith(color: Theme.of(context).colorScheme.onSecondaryContainer),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
