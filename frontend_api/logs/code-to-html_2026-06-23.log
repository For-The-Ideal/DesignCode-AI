}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Doraemon Character Display',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorSchemeSeed: Colors.blue,
        useMaterial3: true,
      ),
      home: const DoraemonPage(),
    );
  }
}

class DoraemonPage extends StatelessWidget {
  const DoraemonPage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: LayoutBuilder(
        builder: (context, constraints) {
          final size = Size(constraints.maxWidth, constraints.maxHeight);
          final shorterSide = size.shortestSide;
          final gridSize = shorterSide * 0.05; // grid cell size proportional to screen

          return Center(
            child: SizedBox(
              width: size.width,
              height: size.height,
              child: Stack(
                alignment: Alignment.center,
                children: [
                  // Background grid pattern
                  Positioned.fill(
                    child: CustomPaint(
                      painter: GridPainter(
                        gridSize: gridSize.clamp(10, 40),
                        color: Colors.grey.withOpacity(0.2),
                      ),
                    ),
                  ),
                  // Character illustration (Doraemon)
                  CustomPaint(
                    size: Size(shorterSide * 0.5, shorterSide * 0.5),
                    painter: DoraemonPainter(),
                  ),
                ],
              ),
            ),
          );
        },
      ),
    );
  }
}

// Painter for background grid pattern
class GridPainter extends CustomPainter {
  final double gridSize;
  final Color color;

  GridPainter({required this.gridSize, required this.color});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = color
      ..strokeWidth = 1.0;

    // Draw vertical lines
    for (double x = 0; x <= size.width; x += gridSize) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), paint);
    }
    // Draw horizontal lines
    for (double y = 0; y <= size.height; y += gridSize) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), paint);
    }
  }

  @override
  bool shouldRepaint(covariant GridPainter oldDelegate) {
    return oldDelegate.gridSize != gridSize || oldDelegate.color != color;
  }
}

// Painter for Doraemon character (simplified illustration)
class DoraemonPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final center = Offset(size.width / 2, size.height / 2);
    final radius = size.width / 2;

    // Body (blue circle)
    final bodyPaint = Paint()
      ..color = const Color(0xFF2196F3) // Material Blue
      ..style = PaintingStyle.fill;
    canvas.drawCircle(center, radius, bodyPaint);

    // Face (white oval)
    final facePaint = Paint()
      ..color = Colors.white
      ..style = PaintingStyle.fill;
    final faceRect = Rect.fromCenter(
      center: center,
      width: radius * 1.2,
      height: radius * 1.0,
    );
    canvas.drawOval(faceRect, facePaint);

    // Eyes (black circles)
    final eyePaint = Paint()
      ..color = Colors.black
      ..style = PaintingStyle.fill;
    final eyeOffset = radius * 0.25;
    final eyeRadius = radius * 0.12;
    canvas.drawCircle(Offset(center.dx - eyeOffset, center.dy - eyeOffset * 0.5), eyeRadius, eyePaint);
    canvas.drawCircle(Offset(center.dx + eyeOffset, center.dy - eyeOffset * 0.5), eyeRadius, eyePaint);

    // Nose (red circle)
    final nosePaint = Paint()
      ..color = Colors.red
      ..style = PaintingStyle.fill;
    final noseRadius = radius * 0.1;
    canvas.drawCircle(Offset(center.dx, center.dy - radius * 0.05), noseRadius, nosePaint);

    // Mouth (arc)
    final mouthPaint = Paint()
      ..color = Colors.black
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.0;
    final mouthRect = Rect.fromCenter(
      center: Offset(center.dx, center.dy + radius * 0.1),
      width: radius * 0.8,
      height: radius * 0.5,
    );
    canvas.drawArc(mouthRect, 0.2, 3.0, false, mouthPaint);

    // Whiskers (lines)
    final whiskerPaint = Paint()
      ..color = Colors.black
      ..strokeWidth = 1.5;
    final whiskerLength = radius * 0.25;
    final whiskerStartY = center.dy - radius * 0.1;
    final whiskerVerticalSpacing = radius * 0.08;

    // Left whiskers
    canvas.drawLine(
      Offset(center.dx - radius * 0.5, whiskerStartY - whiskerVerticalSpacing),
      Offset(center.dx - radius * 0.9, whiskerStartY - whiskerVerticalSpacing),
      whiskerPaint,
    );
    canvas.drawLine(
      Offset(center.dx - radius * 0.5, whiskerStartY),
      Offset(center.dx - radius * 0.9, whiskerStartY),
      whiskerPaint,
    );
    canvas.drawLine(
      Offset(center.dx - radius * 0.5, whiskerStartY + whiskerVerticalSpacing),
      Offset(center.dx - radius * 0.9, whiskerStartY + whiskerVerticalSpacing),
      whiskerPaint,
    );

    // Right whiskers
    canvas.drawLine(
      Offset(center.dx + radius * 0.5, whiskerStartY - whiskerVerticalSpacing),
      Offset(center.dx + radius * 0.9, whiskerStartY - whiskerVerticalSpacing),
      whiskerPaint,
    );
    canvas.drawLine(
      Offset(center.dx + radius * 0.5, whiskerStartY),
      Offset(center.dx + radius * 0.9, whiskerStartY),
      whiskerPaint,
    );
    canvas.drawLine(
      Offset(center.dx + radius * 0.5, whiskerStartY + whiskerVerticalSpacing),
      Offset(center.dx + radius * 0.9, whiskerStartY + whiskerVerticalSpacing),
      whiskerPaint,
    );

    // Bell (yellow circle at bottom center)
    final bellPaint = Paint()
      ..color = Colors.yellow
      ..style = PaintingStyle.fill;
    final bellCenter = Offset(center.dx, center.dy + radius * 0.55);
    final bellRadius = radius * 0.12;
    canvas.drawCircle(bellCenter, bellRadius, bellPaint);

    // Bell line
    final bellLinePaint = Paint()
      ..color = Colors.black
      ..strokeWidth = 1.5;
    canvas.drawLine(
      Offset(bellCenter.dx - bellRadius * 0.8, bellCenter.dy),
      Offset(bellCenter.dx + bellRadius * 0.8, bellCenter.dy),
      bellLinePaint,
    );

    // Collar (red ribbon)
    final collarPaint = Paint()
      ..color = Colors.red
      ..style = PaintingStyle.stroke
      ..strokeWidth = 4.0;
    final collarRect = Rect.fromCircle(center: center, radius: radius * 0.7);
    canvas.drawArc(collarRect, -0.5, 1.0, false, collarPaint);
  }

  @override
  bool shouldRepaint(covariant DoraemonPainter oldDelegate) => false;
}
