class DoraemonPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final double w = size.width;
    final double h = size.height;
    final double headRadius = w * 0.45;
    final double bodyHeight = h * 0.5;
    final double bodyWidth = w * 0.5;
    final Offset center = Offset(w / 2, headRadius + 10);

    // --- 身体 (蓝色) ---
    final bodyRect = Rect.fromCenter(
      center: Offset(w / 2, center.dy + headRadius * 1.1),
      width: bodyWidth,
      height: bodyHeight,
    );
    final bodyPaint = Paint()..color = const Color(0xFF2196F3);
    canvas.drawRRect(
      RRect.fromRectAndRadius(bodyRect, const Radius.circular(20)),
      bodyPaint,
    );

    // --- 头部 (蓝色) ---
    final headPaint = Paint()..color = const Color(0xFF2196F3);
    canvas.drawCircle(center, headRadius, headPaint);

    // --- 白色面部 ---
    final facePaint = Paint()..color = Colors.white;
    final double faceWidth = headRadius * 1.2;
    final double faceHeight = headRadius * 1.0;
    final faceRect = Rect.fromCenter(
      center: Offset(center.dx, center.dy + headRadius * 0.1),
      width: faceWidth,
      height: faceHeight,
    );
    canvas.drawOval(faceRect, facePaint);

    // --- 眼睛 ---
    final double eyeRadius = headRadius * 0.15;
    final double eyeY = center.dy - headRadius * 0.1;
    final double eyeOffsetX = headRadius * 0.25;

    // 眼白
    final eyePaint = Paint()..color = Colors.white;
    canvas.drawOval(
      Rect.fromCenter(
          center: Offset(center.dx - eyeOffsetX, eyeY),
          width: eyeRadius * 2,
          height: eyeRadius * 2.2),
      eyePaint);
    canvas.drawOval(
      Rect.fromCenter(
          center: Offset(center.dx + eyeOffsetX, eyeY),
          width: eyeRadius * 2,
          height: eyeRadius * 2.2),
      eyePaint);
    // 瞳孔
    final pupilPaint = Paint()..color = Colors.black;
    final double pupilRadius = headRadius * 0.07;
    canvas.drawCircle(
        Offset(center.dx - eyeOffsetX, eyeY + headRadius * 0.02),
        pupilRadius, pupilPaint);
    canvas.drawCircle(
        Offset(center.dx + eyeOffsetX, eyeY + headRadius * 0.02),
        pupilRadius, pupilPaint);

    // --- 鼻子 (红色) ---
    final nosePaint = Paint()..color = Colors.red;
    canvas.drawCircle(
        Offset(center.dx, center.dy + headRadius * 0.05), headRadius * 0.08,
        nosePaint);

    // --- 嘴巴 (微笑弧线) ---
    final mouthPaint = Paint()
      ..color = Colors.black
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.0;
    final mouthPath = Path();
    mouthPath.moveTo(center.dx - headRadius * 0.3, center.dy + headRadius * 0.15);
    mouthPath.quadraticBezierTo(
      center.dx,
      center.dy + headRadius * 0.35,
      center.dx + headRadius * 0.3,
      center.dy + headRadius * 0.15,
    );
    canvas.drawPath(mouthPath, mouthPaint);

    // --- 胡须 ---
    final whiskerPaint = Paint()
      ..color = Colors.black
      ..strokeWidth = 2.0;
    for (int i = 0; i < 3; i++) {
      // 左边
      canvas.drawLine(
        Offset(center.dx - headRadius * 0.35, center.dy + headRadius * 0.02 + i * 10),
        Offset(center.dx - headRadius * 0.7, center.dy - headRadius * 0.1 + i * 10),
        whiskerPaint,
      );
      // 右边
      canvas.drawLine(
        Offset(center.dx + headRadius * 0.35, center.dy + headRadius * 0.02 + i * 10),
        Offset(center.dx + headRadius * 0.7, center.dy - headRadius * 0.1 + i * 10),
        whiskerPaint,
      );
    }

    // --- 红色项圈 ---
    final collarPaint = Paint()..color = Colors.red;
    canvas.drawRect(
      Rect.fromCenter(
        center: Offset(center.dx, center.dy + headRadius * 0.8),
        width: headRadius * 1.0,
        height: headRadius * 0.15,
      ),
      collarPaint,
    );

    // --- 铃铛 (金色) ---
    final bellPaint = Paint()..color = const Color(0xFFFFD700);
    final double bellY = center.dy + headRadius * 0.9;
    final double bellRadius = headRadius * 0.12;
    canvas.drawCircle(Offset(center.dx, bellY), bellRadius, bellPaint);
    // 铃铛开口线
    final bellLinePaint = Paint()
      ..color = Colors.black
      ..strokeWidth = 1.5;
    canvas.drawLine(
      Offset(center.dx, center.dy + headRadius * 0.78),
      Offset(center.dx, bellY),
      bellLinePaint,
    );
    // 铃铛小孔
    canvas.drawCircle(
      Offset(center.dx, bellY - headRadius * 0.03),
      headRadius * 0.03,
      bellLinePaint..style = PaintingStyle.stroke,
    );

    // --- 白色腹部 (含口袋轮廓) ---
    final bellyPaint = Paint()..color = Colors.white;
    final bellyRect = Rect.fromCenter(
      center: Offset(w / 2, center.dy + headRadius * 1.5),
      width: bodyWidth * 0.7,
      height: bodyHeight * 0.4,
    );
    canvas.drawOval(bellyRect, bellyPaint);

    // 口袋 (灰色半圆)
    final pocketPaint = Paint()..color = const Color(0xFFBDBDBD);
    final pocketRect = Rect.fromCenter(
      center: Offset(w / 2, center.dy + headRadius * 1.7),
      width: bodyWidth * 0.3,
      height: bodyHeight * 0.15,
    );
    canvas.drawArc(pocketRect, 0, 3.14159, false, pocketPaint..style = PaintingStyle.fill);
    // 口袋边线
    final pocketLinePaint = Paint()
      ..color = Colors.black
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.5;
    canvas.drawArc(pocketRect, 0, 3.14159, false, pocketLinePaint);

    // --- 手臂 (部分可见) ---
    final armPaint = Paint()..color = const Color(0xFF2196F3);
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(0, center.dy + headRadius * 1.3, bodyWidth * 0.2, bodyHeight * 0.2),
        const Radius.circular(10),
      ),
      armPaint,
    );
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(w - bodyWidth * 0.2, center.dy + headRadius * 1.3, bodyWidth * 0.2, bodyHeight * 0.2),
        const Radius.circular(10),
      ),
      armPaint,
    );

    // --- 脚部 (底部露出) ---
    final footPaint = Paint()..color = Colors.white;
    canvas.drawOval(
      Rect.fromCenter(
          center: Offset(w * 0.35, h - 10),
          width: bodyWidth * 0.25,
          height: bodyHeight * 0.15),
      footPaint,
    );
    canvas.drawOval(
      Rect.fromCenter(
          center: Offset(w * 0.65, h - 10),
          width: bodyWidth * 0.25,
          height: bodyHeight * 0.15),
      footPaint,
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}
