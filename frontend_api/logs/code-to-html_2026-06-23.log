  Widget build(BuildContext context) {
    return Scaffold(
      body: LayoutBuilder(
        builder: (context, constraints) {
          final double size = constraints.maxWidth < constraints.maxHeight
              ? constraints.maxWidth
              : constraints.maxHeight;
          final double characterSize = size * 0.7;
          final double gridSpacing = size * 0.04;

          return Stack(
            children: [
              // 背景网格墙
              Positioned.fill(
                child: GridPaper(
                  color: Colors.grey.shade300,
                  divisions: 1,
                  interval: gridSpacing,
                  divisionsColor: Colors.grey.shade400,
                  subdivisions: 1,
                ),
              ),
              // 角色居中
              Center(
                child: SizedBox(
                  width: characterSize,
                  height: characterSize * 1.2,
                  child: CustomPaint(
                    painter: DoraemonPainter(),
                  ),
                ),
              ),
            ],
